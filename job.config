#!/bin/bash

######################
### Bypass Options ###
######################
bypass_madgraph=false
bypass_pythia=false
bypass_preprocessing=false
bypass_train=false

##################################
### Dataset Generation Options ###
##################################
process="U"
generation="inclusive"
MG_tag="${process}_10M_gen"
num_runs=40
num_events_per_run="250k"
max_cpu_cores=40
seed=12

#############################
### Preprocessing Options ###
#############################
R="1.5"
minJetpT="250"
PY_tag="${process}_1M_R${R/./_}_pT${minJetpT}"
dir_datasets="WS_${PY_tag}/datasets_AllFrame"

########################
### Training Options ###
########################
analysis_type="down"
epochs=60
embed_dim=64
training_tag="_${analysis_type}_${epochs}epoch_${embed_dim}embed"
dir_training="WS_${PY_tag}/training${training_tag}"
